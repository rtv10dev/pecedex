# SQLite local (sin Docker)
DATABASE_URL="file:./dev.db"

# Producción (Neon / Postgres) — cuando despliegues en Vercel:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin — genera el hash con:
#   npm run auth:hash -- tu-contraseña --write-env
# Formato scrypt:salt:hash (sin $, para que dotenv no lo corrompa)
ADMIN_PASSWORD_HASH=""

# Identificación por foto (Google AI Studio → API key)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcional (por defecto gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Sketchfab — búsqueda gratis; descarga de modelos CC requiere token
# https://sketchfab.com/settings/password (API token)
SKETCHFAB_API_TOKEN=""

# Google Maps — buscador de ubicaciones (Places API New + Geocoding)
# https://console.cloud.google.com/google/maps-apis
# Activa: Places API (New) y Geocoding API; restringe la key a esas APIs
GOOGLE_MAPS_API_KEY=""
